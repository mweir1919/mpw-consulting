# Leave empty to use the default Calendly diagnostic URL in lib/site.ts.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_CONTACT_EMAIL=hello@mpwconsulting.ca
# Search Console URL-prefix verify. Leave empty if you used a domain DNS TXT instead.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
CONTACT_TO_EMAIL=hello@mpwconsulting.ca
CONTACT_FROM_EMAIL=MPW Consulting <hello@mpwconsulting.ca>
RESEND_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional. Production: from the Weir2 repo run scripts/mpw-wire-contact-mail.sh
# Local next dev can insert via scripts/gws-mpw without these.
# Calendly PAT: Automations → Integrations & apps → API and webhooks
# Scopes: availability:read, availability:write, event_types:read, event_types:write, scheduled_events:read
CALENDLY_API_TOKEN=
